# Copy to .env. Do not give these values to agents.

UTOPIA_IMAGE=ghcr.io/deeplethe/utopia:0.1.0-rc5
UTOPIA_DB_PASSWORD=change-me
UTOPIA_BIND=127.0.0.1:1516
UTOPIA_DB_BIND=127.0.0.1:1517

# Leave empty on first boot so Utopia generates secrets into its data dir.
# UTOPIA_JWT_SECRET=
# UTOPIA_SECRET_KEY=

# Shared only on the compose network. Never publish Headroom to the host.
HEADROOM_PROXY_TOKEN=change-me-headroom-token

# Crux agent port (loopback). Admin token is for enroll/revoke/bootstrap only.
CRUX_BIND=127.0.0.1:8788
CRUX_ADMIN_TOKEN=change-me-crux-admin
CRUX_ADMIN_EMAIL=admin@crux.local
CRUX_ADMIN_PASSWORD=change-me-now-please
CRUX_OWNER_ID=owner-1
CRUX_MODEL=gpt-4o

# After first boot, Crux registers the admin, creates Production + Staging
# restricted bases, and binds agent-prod / agent-staging enrollments.
# Approve facts and edit ontology in Crux — Enterprise Ontology (Utopia)
# at http://127.0.0.1:1516. Do not point chat_base_url at Headroom.
